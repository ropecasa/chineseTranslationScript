{
  "manifest_version": 3,
  "author": "Rodrigo Pérez Casasnovas",
  "name": "Live Chinese Stream Translator",
  "version": "1.2",
  "permissions": [
    "tabCapture",
    "offscreen",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}